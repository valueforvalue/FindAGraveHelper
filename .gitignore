# Local tooling
.antigravitycli/

# Runtime log files produced by background scripts
# (download_application_images, build_pensioncard_viewer,
# distribute_pension_viewer, easyocr_pass, etc). Re-running
# the script reproduces them; commit only the script.
data/*.log
data/applications_download.log
data/build_viewer.log
data/easyocr_install.log
data/easyocr_slice_*.log
data/zip_all_letters.log

# Python bytecode
__pycache__/
*.pyc

# Research artifacts that are large and reproducible from public sources.
# See docs/research/broadened-set/README.md for the URLs to re-download.
docs/research/broadened-set/rosters/

# Local exports of the user's dixiedata database. May contain
# personal/family-tree data the user does not want to publish.
docs/research/local-data/local_soldiers_with_fag.csv
docs/research/local-data/local_fag_records.csv

# Digital Prairie pension records - large and reproducible by
# re-running scripts/scrape_digitalprairie.py. The unified canonical
# list (unified.{json,csv}) IS committed; the per-collection files
# and the scrape log are gitignored.
docs/research/digitalprairie/pensions.csv
docs/research/digitalprairie/pensions.json
docs/research/digitalprairie/pensioncard.csv
docs/research/digitalprairie/pensioncard.json
docs/research/digitalprairie/scrape.log
# J13 enriched input - same 30MB roster + ~636 birth/death_year
# fields added. Reproducible from ok_pensioners.json +
# ok_pensioners.dixiedata_match.json via scripts/enrich/dixiedata_dates.py.
# Don't commit; rebuild in 4s.
docs/research/digitalprairie/ok_pensioners.with_dates.json
# Same provenance as the .ddbak sidecar - the join report.
# Reproducible from the .ddbak in 1s.
docs/research/dixiedata/enrich_report.json

# CGR (Confederate Graves Registry) bulk scrapes — research data
# is COMMITTED to the repo for future reference and cross-state
# comparison. See docs/research/cgr/README.md. The scraper is
# idempotent and resume-safe so it can be re-run; the committed
# copy is the snapshot at time of the original scrape.
#
# If a future scrape supersedes the committed data, replace
# the files in place rather than ignore-then-regenerate.

# Run outputs (state.jsonl, outliers.jsonl, run.log, reports).
# Resume-safe by design (file is flushed per-pensioner + ResumeTracker).
# Keep outputs local; final report is regenerated from this data.
# Exception: data/results/run_2026_07_24_g10_stealth_swap_verification/
# is committed as evidence for the issue #94 stealth swap. See
# data/results/run_2026_07_24_g10_stealth_swap_verification/README.md.
data/results/*
!data/results/run_2026_07_24_g10_stealth_swap_verification/
!data/results/run_2026_07_24_g10_stealth_swap_verification/**
# J5+ per-run output dirs (output/<runname>/). Same resume-safety as
# data/results/ — these are regenerable from the pipeline + config.
output/

# One-off debug artifacts (e.g. screenshots of UI bugs during local
# review). Not part of the codebase; delete after use.
viewerror.png
debug_*.png

# Probe artifacts (one-off investigation scripts + captured HTML/JSON).
# Prefix scripts with underscore (_probe_*.py) and output goes under
# data/probe/. Kept local; the commit message cites key findings inline.
data/probe/
scripts/_probe_*.py

# One-off HTML preview renders from data/preview_view.html experiments.
data/preview_view.html

# Pension card images + per-image OCR results from the red-ink
# OCR pipeline. Reproducible from public IIIF tiles via
# scripts/ingest/download_pensioncard_images.py. ~5GB for the
# full 7709-card set; 5KB/image PNG would be ~2x smaller but
# not worth the conversion cost.
data/cards/img/
data/cards/red_ocr_results.json
data/cards/red_ocr_summary.json
data/cards/download.log
# Application images (the original pension request forms) are
# pulled by scripts/ingest/download_application_images.py and
# follow the same pattern as the cards: one JPEG per pensioner,
# ~1.5GB total. Reproducible from digitalprairie.
data/cards/applications/
# EasyOCR slice/sample artifacts (regenerable via the launcher
# + a fresh --limit N). The smoke-test slice builds drop here
# during local validation; the canonical red_ocr_results.json
# is the only file that needs to persist.
data/cards/easyocr_slice_*.json
data/cards/parallel_smoke_*.json
data/cards/img_sampled_50/
# Allow the enrichment report (small, useful for review):
!data/cards/enrichment_report.json

# HTML/JSON viewer — regenerable from
# scripts/ingest/build_pensioncard_viewer.py. ~17 MB for the full
# set. Keep local for browsing; the script is what we commit.
data/cards/viewer/

# Bundled zip output from distribute_pension_viewer.py (~5 GB).
# Regenerable from the source data + viewer; the script is what
# we commit.
data/pension-viewer-bundle*.zip
data/pension-viewer-bundle*.zip.partial